<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console Appender with MDC test ID -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] [%X{testId:-NO_TEST}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File Appender with MDC test ID -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/test-automation.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/test-automation-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] [%X{testId:-NO_TEST}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- Framework Logger -->
    <logger name="com.automation" level="DEBUG" additivity="false">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- REST Assured Logger -->
    <logger name="io.restassured" level="INFO"/>

    <!-- Playwright Logger (reduce noise) -->
    <logger name="com.microsoft.playwright" level="WARN"/>

    <!-- HikariCP Logger -->
    <logger name="com.zaxxer.hikari" level="INFO"/>

</configuration>
