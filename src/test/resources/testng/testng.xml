<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Core Automation Test Suite" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.automation.listeners.TestListener"/>
    </listeners>

    <!-- Web UI Tests -->
    <test name="Web UI Tests" parallel="methods" thread-count="2">
        <groups>
            <run>
                <include name="ui"/>
            </run>
        </groups>
        <packages>
            <package name="com.automation.webui.*"/>
        </packages>
    </test>

    <!-- API Tests -->
    <test name="API Tests" parallel="methods" thread-count="3">
        <groups>
            <run>
                <include name="api"/>
            </run>
        </groups>
        <packages>
            <package name="com.automation.api.*"/>
        </packages>
    </test>

    <!-- Smoke Tests -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="com.automation.*"/>
        </packages>
    </test>

</suite>