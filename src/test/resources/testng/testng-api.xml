<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Test Suite" parallel="false" verbose="1">
    <parameter name="env" value="local"/>

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.automation.listeners.TestListener"/>
        <listener class-name="com.automation.listeners.RetryListener"/>
    </listeners>

    <test name="Trading API Tests">
        <classes>
            <class name="com.automation.api.TradingAPITests">
                <methods>
                    <!-- Critical Tests -->
                    <include name="testGetTradingPairs"/>
                    <include name="testGetSpecificTradingPair"/>
                    <include name="testGetTickerPrice"/>
                    <include name="testCreateMarketOrder"/>
                    <include name="testCreateLimitOrder"/>

                    <!-- Functional Tests -->
                    <include name="testGet24HourStatistics"/>
                    <include name="testGetMarketDepth"/>
                    <include name="testGetNonExistentTradingPair"/>
                    <include name="testCreateInvalidOrder"/>
                    <include name="testAuthenticatedEndpointRequiresAuth"/>

                    <!-- Performance & Quality Tests -->
                    <include name="testTickerPerformance"/>
                    <include name="testResponseHeaders"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
