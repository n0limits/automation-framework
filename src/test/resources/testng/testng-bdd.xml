<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Core Automation BDD Test Suite" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <!-- All BDD Tests -->
    <test name="All Cucumber BDD Tests" parallel="false">
        <classes>
            <class name="com.automation.bdd.runners.CucumberTestRunner"/>
        </classes>
    </test>

    <!-- UI BDD Tests -->
    <test name="UI BDD Tests" parallel="false">
        <classes>
            <class name="com.automation.bdd.runners.UITestRunner"/>
        </classes>
    </test>

    <!-- API BDD Tests -->
    <test name="API BDD Tests" parallel="false">
        <classes>
            <class name="com.automation.bdd.runners.APITestRunner"/>
        </classes>
    </test>

    <!-- Smoke BDD Tests -->
    <test name="Smoke BDD Tests" parallel="false">
        <classes>
            <class name="com.automation.bdd.runners.SmokeTestRunner"/>
        </classes>
    </test>

</suite>
