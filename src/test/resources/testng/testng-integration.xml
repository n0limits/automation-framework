<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Integration Test Suite" parallel="false" verbose="1">
    <parameter name="env" value="local"/>

    <test name="Trading Workflow Integration Tests">
        <classes>
            <class name="com.automation.integration.TradingWorkflowIntegrationTests">
                <methods>
                    <!-- Critical Integration Tests -->
                    <include name="testAPItoStepFunctionsIntegration"/>
                    <include name="testCompleteTradingWorkflow"/>

                    <!-- Functional Integration Tests -->
                    <include name="testParallelAPIAndWorkflowExecution"/>
                    <include name="testAPIErrorHandlingInWorkflow"/>

                    <!-- Performance Integration Tests -->
                    <include name="testIntegrationPerformance"/>
                </methods>
            </class>
        </classes>
    </test>

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.automation.listeners.TestListener"/>
        <listener class-name="com.automation.listeners.RetryListener"/>
    </listeners>
</suite>
