<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MultiBank Multi-Browser Test Suite" parallel="tests" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.automation.listeners.TestListener"/>
        <listener class-name="com.automation.listeners.RetryListener"/>
    </listeners>

    <!-- Chromium Browser Tests -->
    <test name="All Tests with Chromium" preserve-order="true">
        <parameter name="browser" value="chromium"/>
        <classes>
            <class name="com.automation.multibank.SmokeTests"/>
            <class name="com.automation.multibank.NavigationTests"/>
            <class name="com.automation.multibank.TradingTests"/>
            <class name="com.automation.multibank.PageSectionsTests"/>
            <class name="com.automation.multibank.CrossPageNavigationTests"/>
        </classes>
    </test>

    <!-- Firefox Browser Tests -->
    <test name="All Tests with Firefox" preserve-order="true">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.automation.multibank.SmokeTests"/>
            <class name="com.automation.multibank.NavigationTests"/>
            <class name="com.automation.multibank.TradingTests"/>
            <class name="com.automation.multibank.PageSectionsTests"/>
            <class name="com.automation.multibank.CrossPageNavigationTests"/>
        </classes>
    </test>

    <!-- WebKit Browser Tests -->
    <test name="All Tests with WebKit" preserve-order="true">
        <parameter name="browser" value="webkit"/>
        <classes>
            <class name="com.automation.multibank.SmokeTests"/>
            <class name="com.automation.multibank.NavigationTests"/>
            <class name="com.automation.multibank.TradingTests"/>
            <class name="com.automation.multibank.PageSectionsTests"/>
            <class name="com.automation.multibank.CrossPageNavigationTests"/>
        </classes>
    </test>

</suite>
