<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MultiBank Trading Platform Test Suite" parallel="methods" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.automation.listeners.TestListener"/>
    </listeners>

    <test name="Smoke Tests" preserve-order="true">
        <classes>
            <class name="com.automation.multibank.SmokeTests">
                <methods>
                    <include name="testHomepageLoadsAndIsInteractive"/>
                    <include name="testTradingTableIsInteractive"/>
                    <include name="testFullPageScrollAndReturn"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Navigation Tests" preserve-order="true">
        <classes>
            <class name="com.automation.multibank.NavigationTests">
                <methods>
                    <include name="testNavigationItemIsClickable"/>
                    <include name="testNavigationItemFunctionality"/>
                    <include name="testBrowserBackAfterNavigation"/>
                    <include name="testLanguageSelectorIsVisible"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Trading Functionality Tests" preserve-order="true">
        <classes>
            <class name="com.automation.multibank.TradingTests">
                <methods>
                    <include name="testClickAllPairsTabAndReadData"/>
                    <include name="testTabDisplaysTradingTable"/>
                    <include name="testSwitchTabsMultipleTimes"/>
                    <include name="testTableColumnPresent"/>
                    <include name="testTradingPairDataHasValues"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Page Sections Tests" preserve-order="true">
        <classes>
            <class name="com.automation.multibank.PageSectionsTests">
                <methods>
                    <include name="testScrollToInvestmentCardsSection"/>
                    <include name="testScrollToQuickAccessTools"/>
                    <include name="testScrollToFooterAndVerifyDownloadLinks"/>
                    <include name="testScrollSequenceThroughPage"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Cross-Page Navigation Tests" preserve-order="true">
        <classes>
            <class name="com.automation.multibank.CrossPageNavigationTests">
                <methods>
                    <include name="testNavigateToAboutUsAndBack"/>
                    <include name="testNavigateToMarketsAndBackToDashboard"/>
                    <include name="testMultiStepNavigationWithBrowserHistory"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
