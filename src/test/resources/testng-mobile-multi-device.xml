<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Multi-Device Mobile Test Suite
    Runs UI tests across multiple iOS and Android devices

    Usage:
    Local device emulation: mvn clean test -DsuiteXmlFile=testng-mobile-multi-device.xml
    BrowserStack: mvn clean test -DsuiteXmlFile=testng-mobile-multi-device.xml -Dcloud.provider=browserstack
    Sauce Labs: mvn clean test -DsuiteXmlFile=testng-mobile-multi-device.xml -Dcloud.provider=saucelabs
-->
<suite name="Multi-Device Mobile Test Suite" verbose="1">

    <listeners>
        <listener class-name="com.automation.listeners.TestListener"/>
        <listener class-name="com.automation.listeners.RetryListener"/>
    </listeners>

    <!-- ========== iOS DEVICES ========== -->
    <test name="iPhone 13 - Core Tests" preserve-order="true">
        <parameter name="device" value="iphone_13"/>
        <classes>
            <class name="com.automation.ui.LoginUITests">
                <methods>
                    <include name="testSuccessfulLogin"/>
                    <include name="testLoginPageUIElements"/>
                </methods>
            </class>
            <class name="com.automation.ui.TradingDashboardUITests">
                <methods>
                    <include name="testDashboardLoadsSuccessfully"/>
                    <include name="testTradingPairSelection"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="iPad Pro - Core Tests" preserve-order="true">
        <parameter name="device" value="ipad_pro"/>
        <classes>
            <class name="com.automation.ui.LoginUITests">
                <methods>
                    <include name="testSuccessfulLogin"/>
                </methods>
            </class>
            <class name="com.automation.ui.TradingDashboardUITests">
                <methods>
                    <include name="testDashboardLoadsSuccessfully"/>
                    <include name="testPriceInformationDisplay"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ========== ANDROID DEVICES ========== -->
    <test name="Galaxy S21 - Core Tests" preserve-order="true">
        <parameter name="device" value="galaxy_s21"/>
        <classes>
            <class name="com.automation.ui.LoginUITests">
                <methods>
                    <include name="testSuccessfulLogin"/>
                    <include name="testLoginPageUIElements"/>
                </methods>
            </class>
            <class name="com.automation.ui.TradingDashboardUITests">
                <methods>
                    <include name="testDashboardLoadsSuccessfully"/>
                    <include name="testTradingPairSelection"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Pixel 7 - Core Tests" preserve-order="true">
        <parameter name="device" value="pixel_7"/>
        <classes>
            <class name="com.automation.ui.LoginUITests">
                <methods>
                    <include name="testSuccessfulLogin"/>
                </methods>
            </class>
            <class name="com.automation.ui.TradingDashboardUITests">
                <methods>
                    <include name="testDashboardLoadsSuccessfully"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
