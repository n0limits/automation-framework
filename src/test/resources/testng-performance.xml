<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Performance Test Suite" verbose="1">

    <listeners>
        <listener class-name="com.automation.listeners.TestListener"/>
    </listeners>

    <!-- API Performance Tests -->
    <test name="API Performance Tests" preserve-order="true">
        <classes>
            <class name="com.automation.performance.APIPerformanceTests">
                <methods>
                    <include name="testAPIResponseTimeUnderLoad"/>
                    <include name="testAPIThroughput"/>
                    <include name="testAPISpike"/>
                    <include name="testAPIRampedLoad"/>
                    <include name="testMultipleEndpointsPerformance"/>
                    <include name="testAPIPerformanceConsistency"/>
                    <include name="testAPIErrorRateUnderLoad"/>
                    <include name="testAPIPercentileResponseTimes"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
