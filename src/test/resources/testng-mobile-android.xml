<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Android Mobile Test Suite
    Runs UI tests on Android device emulation

    Usage:
    Local device emulation: mvn clean test -DsuiteXmlFile=testng-mobile-android.xml
    BrowserStack: mvn clean test -DsuiteXmlFile=testng-mobile-android.xml -Dcloud.provider=browserstack
    Sauce Labs: mvn clean test -DsuiteXmlFile=testng-mobile-android.xml -Dcloud.provider=saucelabs
-->
<suite name="Android Mobile Test Suite" verbose="1">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.automation.listeners.TestListener"/>
        <listener class-name="com.automation.listeners.RetryListener"/>
    </listeners>

    <!-- ========== Samsung Galaxy S21 TESTS ========== -->
    <test name="Galaxy S21 - Login UI Tests" preserve-order="true">
        <parameter name="device" value="galaxy_s21"/>
        <classes>
            <class name="com.automation.ui.LoginUITests">
                <methods>
                    <include name="testSuccessfulLogin"/>
                    <include name="testLoginPageUIElements"/>
                    <include name="testLoginWithInvalidUsername"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Galaxy S21 - Trading Dashboard UI Tests" preserve-order="true">
        <parameter name="device" value="galaxy_s21"/>
        <classes>
            <class name="com.automation.ui.TradingDashboardUITests">
                <methods>
                    <include name="testDashboardLoadsSuccessfully"/>
                    <include name="testTradingPairSelection"/>
                    <include name="testPriceInformationDisplay"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- ========== Google Pixel 7 TESTS ========== -->
    <test name="Pixel 7 - Login UI Tests" preserve-order="true">
        <parameter name="device" value="pixel_7"/>
        <classes>
            <class name="com.automation.ui.LoginUITests">
                <methods>
                    <include name="testSuccessfulLogin"/>
                    <include name="testLoginPageUIElements"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Pixel 7 - Trading Dashboard UI Tests" preserve-order="true">
        <parameter name="device" value="pixel_7"/>
        <classes>
            <class name="com.automation.ui.TradingDashboardUITests">
                <methods>
                    <include name="testDashboardLoadsSuccessfully"/>
                    <include name="testTradingPairSelection"/>
                    <include name="testAccountBalanceDisplay"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
